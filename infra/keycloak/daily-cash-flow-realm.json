{
  "realm": "daily-cash-flow",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "local-admin",
      "secret": "local-only",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-local-admin",
      "enabled": true,
      "serviceAccountClientId": "local-admin",
      "clientRoles": {
        "realm-management": [
          "manage-clients"
        ]
      }
    }
  ],
  "clientScopes": [
    {
      "name": "api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "daily-cash-flow-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "entries.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "entries.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "balances.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ]
}
